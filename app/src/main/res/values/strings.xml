<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher label, and nothing else.
  
  Every user-facing string in Larova lives in :core:ui's Compose resources
  (core/ui/src/commonMain/composeResources/values/strings.xml) — the screens are in commonMain and
  cannot see an Android R class. The manifest can only reference an Android resource, though, so
  the app's own name exists here too. It is a proper noun and is never translated, which is the
  only reason a second copy is safe.
-->
<resources>
    <string name="app_name">Larova</string>
</resources>
