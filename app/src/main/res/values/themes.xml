<?xml version="1.0" encoding="utf-8"?>
<!--
  A launch theme only. Everything visible is drawn by Compose, so this exists to give the window
  a background that does not flash against the app's own surfaces before the first frame. The
  values are the light and night backgrounds from docs/design/design-system.md.
-->
<resources>
    <style name="Theme.Larova" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
