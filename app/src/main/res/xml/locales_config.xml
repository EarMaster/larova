<?xml version="1.0" encoding="utf-8"?>
<!--
  Larova · supported app languages.

  Referenced from AndroidManifest.xml:
      <application android:localeConfig="@xml/locales_config" ... >

  Enables the per-app language picker on Android 13+, so a caregiver can set
  Larova to their own language while the child's phone stays in another.
  See docs/localization.md.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en"/>       <!-- English  · default, source language -->
    <locale android:name="de"/>       <!-- German                              -->
    <locale android:name="fr"/>       <!-- French                              -->
    <locale android:name="it"/>       <!-- Italian                             -->
    <locale android:name="es"/>       <!-- Spanish                             -->
    <locale android:name="pt-PT"/>    <!-- Portuguese (Portugal)               -->
    <locale android:name="uk"/>       <!-- Ukrainian                           -->
    <locale android:name="pl"/>       <!-- Polish                              -->
    <locale android:name="ru"/>       <!-- Russian                             -->
    <locale android:name="tr"/>       <!-- Turkish                             -->
    <locale android:name="ar"/>       <!-- Arabic   · right-to-left            -->
    <locale android:name="hi"/>       <!-- Hindi                               -->
    <locale android:name="zh-Hans"/>  <!-- Chinese (Simplified)                -->
    <locale android:name="ja"/>       <!-- Japanese                            -->
</locale-config>
