<?xml version="1.0" encoding="utf-8"?>
<!--
  The pre-Android-12 counterpart of data_extraction_rules.xml. allowBackup="false" already turns
  backup off everywhere, so this is belt and braces — but it is the file an auditor looks for on
  an older device, and it costs four lines.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
