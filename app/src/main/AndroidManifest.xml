<?xml version="1.0" encoding="utf-8"?>
<!--
  Larova · Android manifest.

  There is deliberately no <uses-permission android:name="android.permission.INTERNET" /> here,
  and there never will be. It is on the store listing and in the data safety form; see
  docs/technical-notes.md §7. Calling goes through ACTION_DIAL, media through the photo picker,
  and backups through the system file dialog, so none of those need a permission either.
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      What an app-shortcut tile needs to be able to see: apps with a launcher entry, and nothing
      else. Without this element the app picker comes back empty on Android 11 and later rather
      than failing, which looks like a broken picker instead of a missing declaration.

      QUERY_ALL_PACKAGES is deliberately not used. It is a permission that has to be justified to
      Play review and disclosed to whoever reads the data safety form, and "the parents pick one
      app to put on a tile" is not a case for enumerating everything installed.
    -->
    <!--
      The microphone, for recording a voice onto a tile. Requested at the moment somebody taps
      record and never before: a permission asked for on first launch is a permission asked for
      without a reason the person can see.

      No CAMERA. Pictures and videos come from the photo picker, which runs outside the app, so
      taking one inside Larova would buy a permission for something the phone already does better.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Both of these arrive from androidx.media3:media3-exoplayer and both are removed here, because
      AGENTS.md says the permission list is RECORD_AUDIO and nothing else, and a permission a person
      can see in the phone's settings is part of the promise whether it grants anything or not.
      "View network connections" on an app that advertises having no internet permission reads as a
      contradiction, and being right on a technicality is not the same as being trusted.

      ExoPlayer wants them for playback Larova does not do: ACCESS_NETWORK_STATE for measuring
      bandwidth while streaming, WAKE_LOCK for `setWakeMode`, which nothing here calls. Every file
      played is a local one under filesDir. Media3 catches the SecurityException from the
      connectivity lookup when the permission is absent — verified in the bytecode of
      NetworkTypeObserver, which has an exception table entry for exactly that — and reports an
      unknown network type, which is true and unused.

      If playback ever breaks in a way that traces back to either of these, put the one it needs
      back with the reason written next to it rather than removing this block.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WAKE_LOCK"
        tools:node="remove" />

    <!--
      INTERNET is removed rather than merely absent, and it has to be said explicitly because it is
      no longer only this file that decides.

      com.android.billingclient:billing depends on com.google.android.datatransport, whose manifest
      declares INTERNET and ACCESS_NETWORK_STATE and whose job is uploading telemetry to Google.
      That dependency is excluded in core/billing/build.gradle.kts, so nothing merges it in today
      and this line is a no-op — which is exactly what it is for. A version bump that reintroduces
      the dependency fails the permission check in ci.yml instead of quietly shipping INTERNET in
      an app whose store listing, README and privacy policy all say it has none.

      Billing itself needs no network permission here. It binds over IPC to the Play Store, which
      does the network under its own. The one permission it does contribute is
      com.android.vending.BILLING: protectionLevel normal, declared by the Play Store, in no
      permission group, so it grants nothing and appears in no permission list on the phone. Play's
      listing shows an "In-app purchases" badge instead, which is honest and is the point.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!--
          What the Translate control on a tile needs to be able to see. Larova translates nothing
          itself and has no permission with which to; it asks whether anything here will take the
          words on a tile, and hands them over if so.

          Two actions because phones differ, not because of the SDK level: ACTION_TRANSLATE is
          tried first and is where a phone with a translation app lands, and PROCESS_TEXT is the
          older route that Google Translate and others still register for. TranslateIntents builds
          exactly these two, in this order.

          The mimeType below has to match the launched intent exactly. Declaring the action alone
          while launching one with a type set is the classic reason queryIntentActivities comes
          back empty on Android 11 and later — and the control then never appears at all, which
          looks like a feature that was never built rather than a declaration that is one line
          short. QUERY_ALL_PACKAGES is deliberately not used here either.
        -->
        <intent>
            <action android:name="android.intent.action.TRANSLATE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".LarovaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Larova">

        <!--
          singleTop because of the launcher shortcuts: tapping one while Larova is already open
          should bring the tile up in the app that is running, not start a second copy of it beside
          the first. The new intent arrives in onNewIntent instead.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|fontScale"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Larova">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
